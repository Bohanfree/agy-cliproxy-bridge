# Native Node.js mode: install and sign in to agy separately.
AGY_API_KEY_FILE=./api.key
BIND=127.0.0.1
PORT=9437
AGY_BRIDGE_MAX_PROCS=2
AGY_BRIDGE_IDLE_MS=120000
AGY_BRIDGE_START_TIMEOUT_MS=30000
AGY_BRIDGE_TURN_TIMEOUT_MS=180000
AGY_CLI_DISABLE_AUTO_UPDATE=true
# Optional: absolute path if agy is not on PATH.
# AGY_PATH=/absolute/path/to/agy

# Advanced Compose mode reuses an EXISTING Linux Magpie/AGY environment.
# Its keyring must already be running and signed in. See docs/deployment.md.
# MAGPIE_CONFIG_DIR=/absolute/path/to/existing/magpie-config
# CPA_NETWORK=cliproxy-stack_default
# BRIDGE_HOST_PORT=19437
# BUN_PATH=/config/cache/magpie/bun/1.4.4/magpie-bun
